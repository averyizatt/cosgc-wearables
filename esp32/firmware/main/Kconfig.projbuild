menu "tinyasr"
    choice TASR_MODE
        prompt "Input source"
        default TASR_MODE_FILE
        config TASR_MODE_FILE
            bool "Benchmark: utterances stored in the 'audio' partition"
        config TASR_MODE_MIC
            bool "Live: I2S MEMS microphone (e.g. INMP441)"
    endchoice
    config TASR_I2S_BCLK
        int "I2S BCLK (SCK) GPIO"
        default 4
    config TASR_I2S_WS
        int "I2S WS (LRCL) GPIO"
        default 5
    config TASR_I2S_DIN
        int "I2S data-in (SD) GPIO"
        default 6
    config TASR_PTT_GPIO
        int "Push-to-talk button GPIO (button to GND, internal pull-up); -1 = none"
        default -1
        range -1 48
        help
            With a button, an utterance is what you say while holding it (plus 0.3 s from before the press) and the
            final text comes as soon as it is released, with no end-of-speech pause; noise is never transcribed.
            Without one (-1), the energy VAD starts and ends utterances.
    config TASR_LED_GPIO
        int "Status LED: addressable RGB LED (WS2812) GPIO; -1 = none"
        default -1
        range -1 48
        help
            GPIO48 on ESP32-S3-DevKitC-1 v1.0 (and most N16R8 clones), GPIO38 on v1.1. Dim blue: loading; dim green:
            ready; blue: hearing you; amber: computing the final text; green flash: text ready; red flash: nothing
            recognized; purple: audio buffer full (recognition is behind, audio is dropped).
    config TASR_SEG_HANG_MS
        int "Pause (ms) that ends an utterance in microphone mode"
        default 800
        help
            Silence after speech before the utterance is closed and its final text printed. With a streaming
            model almost all compute is done by then, so this pause is most of the latency; voice agents
            typically use 400-600 ms (or their own turn detector).
    config TASR_BENCH_PACED
        bool "File mode: also stream every clip at real-time pace and report when the final text appears"
        default n
        help
            Benchmark builds only. The clip is fed in 20 ms blocks, each one when its last sample would have been
            spoken, so the delay of the final text after the end of speech includes any backlog if the chip is slower
            than real time.

    config TASR_BENCH_STREAM_ONLY
        bool "File mode: streaming passes only (no utterance-mode pass; TOTAL is the streaming RTF)"
        default n

    config TASR_KERNEL_BENCH
        bool "Benchmark: at boot, time the int8 GEMM kernels with weights in internal RAM, PSRAM and flash"
        default n
        help
            Prints KBENCH lines: cycles per multiply-accumulate for each placement. If PSRAM and flash are close to
            internal RAM, the kernels are not waiting for weights.

    config TASR_O3
        bool "Compile the engine with -O3 -funroll-loops instead of -O2"
        default y
        help
            Same results (no fast-math, fused multiply-add stays off). Measured on an N16R8 board: 2.3 % faster
            than -O2 (real-time factor 1.833 against 1.877 on the oido_s3_bench clips).

    config TASR_EXP_NO_PSRAM_WEIGHTS
        bool "Experiment: keep all weights in flash (no copies in PSRAM)"
        default n

    config TASR_EXP_SPIN_PARFOR
        bool "Experiment: two-core parallel-for with spin-waiting instead of FreeRTOS semaphores"
        default n

    config TASR_EXP_NOINT
        bool "Experiment (with spin-wait): interrupts masked on both cores while a job runs"
        depends on TASR_EXP_SPIN_PARFOR
        default n

    config TASR_PAR_MASK
        int "Experiment: bit mask of the parallel call sites that use both cores (0 gives all-serial); unset = all"
        default 511
        depends on TASR_EXP_PAR_MASK_ON

    config TASR_EXP_PAR_MASK_ON
        bool "Experiment: enable TASR_PAR_MASK"
        default n

    config TASR_XR_MAX_KP
        int "int8 rows of up to this many bytes use the x-stationary kernel, longer ones the row kernel"
        default 256
        help
            1024 keeps tasr_dot_rows_s8 (the row kernel, which crashes when both cores run it) out of the K=704
            and language-model GEMMs.

    config TASR_EXP_LM_SERIAL
        bool "Experiment (two cores): run the language model's matrix products on one core"
        default n

    config TASR_EXP_XQ_COPY
        bool "Experiment: worker 1 reads a private copy of the activation tile in the K=704 GEMMs"
        default n

    config TASR_EXP_XQ_PSRAM
        bool "Experiment: activation tile in PSRAM instead of internal SRAM"
        default n

    config TASR_EXP_DOT_DUP
        bool "Experiment: each core runs its own copy of the dot-product kernel"
        default n

    config TASR_EXP_DOT_IRAM
        bool "Experiment: dot-product kernel in IRAM"
        default n

    config TASR_EXP_ROWSPLIT
        bool "Experiment: split the K=704 matrix products over rows instead of output channels"
        default n

    config TASR_OLED
        bool "SSD1306 128x64 I2C OLED showing the live transcript"
        default n
    config TASR_OLED_SDA
        int "OLED SDA GPIO"
        default 8
        depends on TASR_OLED
    config TASR_OLED_SCL
        int "OLED SCL GPIO"
        default 9
        depends on TASR_OLED
    config TASR_OLED_ADDR
        hex "OLED I2C address"
        default 0x3C
        depends on TASR_OLED
    config TASR_CHUNK
        int "Encoder chunk (25 Hz frames, even); 32 = 1.28 s"
        default 32
    config TASR_LEFT
        int "Attention history in chunks"
        default 2
    config TASR_BEAM
        int "Beam width when an LM partition is present"
        default 4
    config TASR_LM_WEIGHT_X100
        int "LM weight x100"
        default 60
    config TASR_TOKEN_BONUS_X100
        int "Token insertion bonus x100"
        default 250
endmenu
